{
  "mcpServers": {
    "runninghub": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/tolatolatop/runninghub-mcp", "runninghub-mcp"],
      "env": {
        "RUNNINGHUB_API_KEY": "${RUNNINGHUB_API_KEY}",
        "RUNNINGHUB_API_HOST": "www.runninghub.ai"
      }
    }
  }
}
